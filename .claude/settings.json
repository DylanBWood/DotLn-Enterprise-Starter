{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/launchpad.mjs update --publish *)",
      "Bash(node scripts/refute-plan.mjs publish *)",
      "Bash(node scripts/worktree.mjs publish *)"
    ],
    "deny": [
      "Bash(npm publish *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(ssh *)",
      "Skill(anthropic-skills:built-in-browser *)",
      "Skill(anthropic-skills:built-in-browser)",
      "Skill(anthropic-skills:chrome-browser *)",
      "Skill(anthropic-skills:chrome-browser)",
      "Skill(anthropic-skills:computer-use *)",
      "Skill(anthropic-skills:computer-use)",
      "Skill(claude-in-chrome *)",
      "Skill(claude-in-chrome)",
      "Skill(skill:anthropic-skills:built-in-browser)",
      "Skill(skill:anthropic-skills:chrome-browser)",
      "Skill(skill:anthropic-skills:computer-use)",
      "Skill(skill:claude-in-chrome)",
      "enable__mcp__claude-in-chrome*",
      "enable__mcp__remote-devices__Claude_Browser*",
      "enable__mcp__remote-devices__computer*",
      "mcp__Claude_Browser__*",
      "mcp__claude-in-chrome__*",
      "mcp__computer-use__*",
      "mcp__remote-devices__Claude_Browser__*",
      "mcp__remote-devices__computer_*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(?!(?:Agent|AskUserQuestion|EnterPlanMode|ExitPlanMode|Glob|Grep|KillShell|ListMcpResourcesTool|Read|ReadMcpResourceTool|SendMessage|Skill|StructuredOutput|SubagentHandback|Task|TaskOutput|TaskStop|TodoWrite|ToolSearch|WebFetch|WebSearch|Workflow|collaboration\\.spawn_agent|enable__mcp__claude-in-chrome[\\s\\S]*|enable__mcp__remote-devices__Claude_Browser[\\s\\S]*|enable__mcp__remote-devices__computer[\\s\\S]*|mcp__Claude_Browser__[\\s\\S]*|mcp__claude-in-chrome__[\\s\\S]*|mcp__computer-use__[\\s\\S]*|mcp__remote-devices__Claude_Browser__[\\s\\S]*|mcp__remote-devices__computer_[\\s\\S]*)$)[\\s\\S]*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/concurrent-work-requires-worktrees.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(?!(?:Agent|AskUserQuestion|Edit|EnterPlanMode|ExitPlanMode|Glob|Grep|KillShell|ListMcpResourcesTool|NotebookEdit|Read|ReadMcpResourceTool|SendMessage|Skill|StructuredOutput|SubagentHandback|Task|TaskOutput|TaskStop|TodoWrite|ToolSearch|WebFetch|WebSearch|Workflow|Write|apply_patch|collaboration\\.spawn_agent|enable__mcp__claude-in-chrome[\\s\\S]*|enable__mcp__remote-devices__Claude_Browser[\\s\\S]*|enable__mcp__remote-devices__computer[\\s\\S]*|mcp__Claude_Browser__[\\s\\S]*|mcp__claude-in-chrome__[\\s\\S]*|mcp__computer-use__[\\s\\S]*|mcp__remote-devices__Claude_Browser__[\\s\\S]*|mcp__remote-devices__computer_[\\s\\S]*)$)[\\s\\S]*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-attribution.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/permissions.mjs\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/write-observer.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?!(?:Agent|AskUserQuestion|Bash|EnterPlanMode|ExitPlanMode|Glob|Grep|KillShell|ListMcpResourcesTool|Monitor|Read|ReadMcpResourceTool|SendMessage|Skill|StructuredOutput|SubagentHandback|Task|TaskOutput|TaskStop|TodoWrite|ToolSearch|WebFetch|WebSearch|Workflow|collaboration\\.spawn_agent|enable__mcp__claude-in-chrome[\\s\\S]*|enable__mcp__remote-devices__Claude_Browser[\\s\\S]*|enable__mcp__remote-devices__computer[\\s\\S]*|exec_command|functions\\.exec|mcp__Claude_Browser__[\\s\\S]*|mcp__claude-in-chrome__[\\s\\S]*|mcp__computer-use__[\\s\\S]*|mcp__remote-devices__Claude_Browser__[\\s\\S]*|mcp__remote-devices__computer_[\\s\\S]*|write_stdin)$)[\\s\\S]*$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-lint-type-disables-as-fixes.mjs\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/read-observer.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/permission-denied.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-finished.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/failure-observer.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session.mjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/finish.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
